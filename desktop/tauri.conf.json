{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LootWeave",
  "version": "0.1.0",
  "identifier": "dev.lootweave.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "local-capture",
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "http://127.0.0.1:*"
            ]
          },
          "permissions": [
            "core:default",
            "allow-capture-region",
            "allow-detect-deskrawl-windows",
            "allow-capture-deskrawl-region"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../dist/sidecar/": "sidecar/"
    },
    "icon": [
      "../.local/generated/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "useLocalToolsDir": true
  }
}
